{
  "name": "@beastjs/auth",
  "version": "0.1.0",
  "description": "Wire Firebase and firebase-admin into a Beast app: project, Google sign-in, codegen, env files, founder claims and console subdomains, in one interactive command.",
  "keywords": [
    "beast",
    "btsx",
    "tsrx",
    "octane",
    "firebase",
    "firebase-admin",
    "auth",
    "custom-claims",
    "cloudflare-workers",
    "subdomain",
    "rsbuild",
    "codegen",
    "cli"
  ],
  "license": "ISC",
  "author": "phtn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beastjs/auth.git"
  },
  "homepage": "https://github.com/beastjs/auth#readme",
  "bugs": {
    "url": "https://github.com/beastjs/auth/issues"
  },
  "type": "module",
  "bin": {
    "beast-auth": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --target node --outdir dist --format esm --external firebase-admin --external @clack/prompts --external picocolors",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test",
    "proof": "bun run tools/compile-proof.ts",
    "prepack": "bun run build",
    "prepublishOnly": "bun run check"
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "firebase-admin": "^14.5.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
